{
  "uid": "seckill-api-red",
  "title": "Seckill / API RED",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": [
    "observability",
    "environment"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求速率",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total[2m]))",
          "refId": "A",
          "legendFormat": "{{service}} {{job}} {{role}} {{owner}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "系统错误速率",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{service}} {{job}} {{role}} {{owner}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (le,service)(rate(http_request_duration_seconds_bucket[2m])))",
          "refId": "A",
          "legendFormat": "{{service}} {{job}} {{role}} {{owner}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99,sum by (le,service)(rate(http_request_duration_seconds_bucket[2m])))",
          "refId": "A",
          "legendFormat": "{{service}} {{job}} {{role}} {{owner}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "description": "全环境实时观测；缺失值不补零。业务审计面板必须同时查看 freshness；零负库存不等于已证明库存守恒。",
  "links": [
    {
      "title": "工作台监控",
      "url": "http://127.0.0.1:8099/#monitoring"
    },
    {
      "title": "排障手册",
      "url": "http://127.0.0.1:8099/docs/observability/p3-runbooks.md"
    }
  ]
}
